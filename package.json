{
  "name": "gitea-dev",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Client-only Code OSS workbench for self-hosted Gitea",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "assets": "tsx scripts/assets.ts",
    "package": "node scripts/package.mjs",
    "instance:start": "node scripts/local-instance.mjs start",
    "instance:stop": "node scripts/local-instance.mjs stop",
    "instance:status": "node scripts/local-instance.mjs status"
  },
  "dependencies": {
    "just-bash": "^3.4.2",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.8",
    "@types/vscode": "1.104.0",
    "esbuild": "0.25.11",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "21.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
